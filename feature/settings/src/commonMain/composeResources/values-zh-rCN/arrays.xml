     因为它确实是本地化文本）。机器值数组 `backup_sync_mode_value` 只放默认 values/。 -->
<string-array name="backup_sync_mode">
        <item>备份至本地与网络</item>
        <item>备份至本地</item>
        <item>备份至网络</item>
    </string-array>
